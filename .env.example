HOST=127.0.0.1
PORT=5055
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
LOW_ATTENDANCE_THRESHOLD=75
FRONTEND_URL=https://your-frontend.example.com
BACKEND_URL=https://your-backend.example.com
CLIENT_ORIGIN=https://your-frontend.example.com
# Optional for a separately hosted frontend; same-origin Render deployments can leave this unset.
VITE_API_URL=https://your-backend.example.com/api
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=use-a-unique-admin-password
# Passwords must be 12-200 characters and include upper/lower-case, a number, and a symbol.
SEED_STUDENT_PASSWORD=use-a-unique-student-password
SEED_FACULTY_PASSWORD=use-a-unique-temporary-faculty-password
DEMO_LOGIN_EMAIL=demo@example.edu
DEMO_LOGIN_PASSWORD=use-a-unique-demo-password
E2E_ADMIN_PASSWORD=use-a-unique-e2e-admin-password
E2E_FACULTY_PASSWORD=use-a-unique-e2e-faculty-password

# Rate limiting. Values are milliseconds except *_LIMIT counters.
AUTH_API_WINDOW_MS=900000
AUTH_API_LIMIT=100
AUTH_API_BACKOFF_BASE_MS=500
AUTH_API_BACKOFF_MAX_MS=60000
AUTH_LOGIN_IP_WINDOW_MS=900000
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_IP_BACKOFF_BASE_MS=1000
AUTH_LOGIN_IP_BACKOFF_MAX_MS=60000
AUTH_LOGIN_ACCOUNT_WINDOW_MS=900000
AUTH_LOGIN_ACCOUNT_LIMIT=8
AUTH_LOGIN_ACCOUNT_BACKOFF_BASE_MS=2000
AUTH_LOGIN_ACCOUNT_BACKOFF_MAX_MS=300000
AUTH_SIGNUP_WINDOW_MS=3600000
AUTH_SIGNUP_LIMIT=10
AUTH_SIGNUP_BACKOFF_BASE_MS=2000
AUTH_SIGNUP_BACKOFF_MAX_MS=600000
PUBLIC_API_WINDOW_MS=60000
PUBLIC_API_LIMIT=120
PUBLIC_API_BACKOFF_BASE_MS=250
PUBLIC_API_BACKOFF_MAX_MS=10000
SEARCH_API_WINDOW_MS=60000
SEARCH_API_LIMIT=30
SEARCH_API_BACKOFF_BASE_MS=250
SEARCH_API_BACKOFF_MAX_MS=10000
ADMIN_API_WINDOW_MS=60000
ADMIN_API_LIMIT=60
ADMIN_API_BACKOFF_BASE_MS=500
ADMIN_API_BACKOFF_MAX_MS=30000
AUDIT_LOG_MAX_EVENTS=10000
FACULTY_QUIZ_CREATE_WINDOW_MS=300000
FACULTY_QUIZ_CREATE_LIMIT=30
STUDENT_COMPLETION_WINDOW_MS=300000
STUDENT_COMPLETION_LIMIT=20
STUDENT_QUIZ_ANSWER_WINDOW_MS=300000
STUDENT_QUIZ_ANSWER_LIMIT=10
ATTENDANCE_MARK_WINDOW_MS=60000
ATTENDANCE_MARK_LIMIT=60

# Teacher accounts should use unique passwords configured per teacher below.
#
# Optional: give an individual faculty member (by their teacher code, see
# server/db/seedData.js -> teacherProfiles) their own real login instead of
# the "<CODE>@Uem2026" demo password above. Example for the SBK code:
# FACULTY_SBK_EMAIL=faculty.member@example.edu
# FACULTY_SBK_PASSWORD=use-a-unique-faculty-password

# Geofenced quiz attendance: the app itself works from anywhere (any city,
# any network), but a student can only submit an answer to an attendance
# quiz when their device's GPS location is within COLLEGE_RADIUS_METERS of
# this point. (Students can no longer self-check-in directly - only a
# correct quiz answer or a teacher/admin marking them by hand adds an
# attendance record.) Look up your campus's coordinates (e.g. via Google
# Maps: right-click the spot -> click the lat/lng) and set them here. Leave
# unset to disable the geofence check entirely.
#
# Set below to University of Engineering & Management (UEM), Jaipur -
# Gurukul, Sikar Road, Jaipur. Campus is ~32 acres; 300m covers the whole
# built-up area plus normal GPS drift without reaching the public highway
# out front. Narrow this down (e.g. to 120-150m) if you want the check
# tighter to a single building/block instead of the whole campus.
COLLEGE_LATITUDE=27.2124649
COLLEGE_LONGITUDE=75.7002425
COLLEGE_RADIUS_METERS=300
SUBMISSION_MAX_BYTES=5242880
# Submission files are written outside the public web root. Use durable object
# storage for production if files must survive Render service replacement.
UPLOAD_DIR=./storage/submissions

# Teacher accounts: each teacher code (e.g. LRG, SBK - these are visible to
# any student on the public class schedule) gets a demo login of
# <CODE>@Uem2026 unless you set FACULTY_<CODE>_EMAIL / FACULTY_<CODE>_PASSWORD
# for that code. In production, the server refuses to start if any teacher
# is still on the guessable demo password, since anyone who's seen a
# timetable can compute it. Either set real passwords for every teacher code
# you use, or explicitly accept the demo passwords (e.g. for a staging
# deployment) with:
# ALLOW_DEMO_TEACHER_PASSWORDS=true
