# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Variables with a code default below are optional — the app will run
# without them. Variables marked "required" must be set for the server
# to start in that mode.

# ---------------------------------------------------------------------------
# Core / required for any run
# ---------------------------------------------------------------------------

# Required. Signing secret for access/refresh JWTs. Must be a random value
# of at least 32 characters, or the server refuses to start
# (see server/middleware/auth.js).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Required. One of: development | test | production. Controls demo-login
# gating, seed behavior, CORS strictness, HSTS, and log verbosity.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Required in production only
# ---------------------------------------------------------------------------

# Postgres connection string. When unset, the app falls back to a local
# JSON-file "DB" and an in-memory rate-limit backend — fine for dev/test,
# not for a real multi-instance production deployment.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Seed / demo accounts (server/db/seedData.js)
# ---------------------------------------------------------------------------

# Admin account created by the seeder.
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_NAME=Admin
# Required in production (throws on startup if unset there). In dev/test, a
# random compliant password is generated if left blank.
SEED_ADMIN_PASSWORD=

# Required in production; random compliant password generated if blank in
# dev/test.
SEED_STUDENT_PASSWORD=

# Shared password applied to every seeded faculty account. In production,
# omitting this is only allowed if ALLOW_DEMO_TEACHER_PASSWORDS=true.
SEED_FACULTY_PASSWORD=
ALLOW_DEMO_TEACHER_PASSWORDS=false

# Enables/exposes the built-in demo-login shortcut. Defaults: on in
# dev/test (ALLOW_DEMO_LOGIN=false to disable), off in production
# (ALLOW_DEMO_LOGIN=true to enable).
ALLOW_DEMO_LOGIN=
DEMO_LOGIN_EMAIL=example@gmail.com

# End-to-end seed accounts. Only seeded when NODE_ENV != production, or
# when RUN_E2E_SEED=true in production. Required whenever E2E seeding is
# enabled (throws on startup otherwise); random compliant password
# generated when E2E seeding is disabled.
RUN_E2E_SEED=false
E2E_FACULTY_PASSWORD=
E2E_ADMIN_PASSWORD=

# Optional per-account credential overrides also exist for individual
# seeded accounts (FACULTY_<CODE>_EMAIL / FACULTY_<CODE>_PASSWORD, and a
# generated ACCOUNT_<ID>_EMAIL / ACCOUNT_<ID>_PASSWORD per admin/student/
# teacher record — see accountEnvPrefix() in server/db/seedData.js). These
# are optional, per-account escape hatches and are intentionally not
# enumerated here.

# ---------------------------------------------------------------------------
# Geofence (server/utils/geo.js) — required for QR check-in to work
# ---------------------------------------------------------------------------

# Without both latitude and longitude set, getCollegeGeofence() returns
# null and geofenced check-in/quiz-attendance features fail closed.
COLLEGE_LATITUDE=
COLLEGE_LONGITUDE=
# Code default: 200
COLLEGE_RADIUS_METERS=200

# ---------------------------------------------------------------------------
# CORS / origins
# ---------------------------------------------------------------------------

# Comma-separated list of allowed browser origins. CLIENT_ORIGIN takes
# precedence over FRONTEND_URL if both are set.
# Code default: http://localhost:5175,http://127.0.0.1:5175
#
# Each entry must be a bare origin - scheme + host + optional port, with no
# trailing path ("https://portal.example.edu", not
# "https://portal.example.edu/app"). The server validates this at startup
# (server/config/clientOrigin.js) and REFUSES TO BOOT in production if it is
# missing, unparseable, or points at localhost/127.0.0.1, because this value
# is also the public link base for password-reset emails. Outside production
# an invalid value only logs a warning.
CLIENT_ORIGIN=
# Also used as the link base in outgoing emails (password reset, etc.).
FRONTEND_URL=http://localhost:5175
#
# Note on attendance QR codes: these are NOT affected by the variables above.
# The server returns an origin-less path (`qrPath`) and the teacher's browser
# resolves it against its own window.location.origin, so a scanned QR always
# points back at the deployment the teacher is actually using.

# ---------------------------------------------------------------------------
# Server networking
# ---------------------------------------------------------------------------

# Code default: 1 (trusts exactly one upstream reverse proxy for
# X-Forwarded-For). Set this explicitly rather than relying on the default -
# it must match your real deployment (0 if there's no proxy in front of this
# process, a higher number for a longer proxy chain). Getting this wrong lets
# a client spoof its IP for rate limiting and audit logging. The server logs
# a startup warning if this is left unset.
TRUST_PROXY=1

# Attendance reminder emails (POST /attendance/sessions/:id/remind).
# Rate-limited per teacher+session so rotating a QR mid-class can't become a
# way to mail the class repeatedly. Code defaults: 3 sends per 5 minutes.
# Requires SMTP below; without it the send is recorded but no email goes out.
ATTENDANCE_REMIND_WINDOW_MS=300000
ATTENDANCE_REMIND_LIMIT=3
# Code default: 5055
PORT=5055
# Code default: 127.0.0.1
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# SMTP (optional — email sending degrades gracefully / logs to console
# when unset; see server/services/emailService.js)
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# "true" forces TLS; otherwise defaults to true only when SMTP_PORT is 465.
SMTP_SECURE=

# ---------------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------------

# Code default: <cwd>/storage/faculty-notes (faculty.js) and a parallel
# default under storage/ for shared.js submissions.
UPLOAD_DIR=
# Max upload size in bytes. Code default: 5242880 (5 MB)
SUBMISSION_MAX_BYTES=5242880

# Final-year project documents (milestone/final-report uploads). Separate
# from UPLOAD_DIR above so it can never collide on disk with faculty-notes or
# submissions. Code default dir: <cwd>/storage/project-documents. Code
# default size: 15728640 (15 MB).
PROJECT_UPLOAD_DIR=
PROJECT_MAX_BYTES=15728640

# ---------------------------------------------------------------------------
# Audit log
# ---------------------------------------------------------------------------

# Max retained audit events (oldest trimmed beyond this). Code default:
# 10000; hard floor of 1000.
AUDIT_LOG_MAX_EVENTS=10000

# ---------------------------------------------------------------------------
# Rate limiting — tuning only, all optional (server/middleware/rateLimit.js)
# ---------------------------------------------------------------------------

# In-memory bucket store limits (only relevant when DATABASE_URL is unset).
# Code defaults: 10000 / 60000
RATE_LIMIT_MAX_BUCKETS=10000
RATE_LIMIT_CLEANUP_MS=60000

# Each limiter below follows the same <PREFIX>_WINDOW_MS / <PREFIX>_LIMIT /
# <PREFIX>_BACKOFF_BASE_MS / <PREFIX>_BACKOFF_MAX_MS shape. Only set the
# ones you want to override — every one has a code default.

# Global /api limiter. Code defaults: windowMs=60000, limit=120,
# backoffBaseMs=250, backoffMaxMs=10000
PUBLIC_API_WINDOW_MS=60000
PUBLIC_API_LIMIT=120
PUBLIC_API_BACKOFF_BASE_MS=250
PUBLIC_API_BACKOFF_MAX_MS=10000

# /api/auth limiter. Code defaults: windowMs=900000, limit=100,
# backoffBaseMs=500, backoffMaxMs=60000
AUTH_API_WINDOW_MS=900000
AUTH_API_LIMIT=100
AUTH_API_BACKOFF_BASE_MS=500
AUTH_API_BACKOFF_MAX_MS=60000

# Per-IP login limiter. Code defaults: windowMs=900000, limit=20,
# backoffBaseMs=1000, backoffMaxMs=60000
AUTH_LOGIN_IP_WINDOW_MS=900000
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_IP_BACKOFF_BASE_MS=1000
AUTH_LOGIN_IP_BACKOFF_MAX_MS=60000

# Per-account login limiter. Code defaults: windowMs=900000, limit=8,
# backoffBaseMs=2000, backoffMaxMs=300000
AUTH_LOGIN_ACCOUNT_WINDOW_MS=900000
AUTH_LOGIN_ACCOUNT_LIMIT=8
AUTH_LOGIN_ACCOUNT_BACKOFF_BASE_MS=2000
AUTH_LOGIN_ACCOUNT_BACKOFF_MAX_MS=300000

# Signup limiter. Code defaults: windowMs=3600000, limit=10,
# backoffBaseMs=2000, backoffMaxMs=600000
AUTH_SIGNUP_WINDOW_MS=3600000
AUTH_SIGNUP_LIMIT=10
AUTH_SIGNUP_BACKOFF_BASE_MS=2000
AUTH_SIGNUP_BACKOFF_MAX_MS=600000

# Global search limiter. Code defaults: windowMs=60000, limit=30,
# backoffBaseMs=250, backoffMaxMs=10000
SEARCH_API_WINDOW_MS=60000
SEARCH_API_LIMIT=30
SEARCH_API_BACKOFF_BASE_MS=250
SEARCH_API_BACKOFF_MAX_MS=10000

# /api/admin limiter. Code defaults: windowMs=60000, limit=60,
# backoffBaseMs=500, backoffMaxMs=30000
ADMIN_API_WINDOW_MS=60000
ADMIN_API_LIMIT=60
ADMIN_API_BACKOFF_BASE_MS=500
ADMIN_API_BACKOFF_MAX_MS=30000

# Manual attendance-mark limiter. Code defaults: windowMs=60000, limit=100
ATTENDANCE_MARK_WINDOW_MS=60000
ATTENDANCE_MARK_LIMIT=100

# Faculty quiz-creation limiter. Code defaults: windowMs=300000, limit=30
FACULTY_QUIZ_CREATE_WINDOW_MS=300000
FACULTY_QUIZ_CREATE_LIMIT=30

# Student assignment/task completion-toggle limiter. Code defaults:
# windowMs=300000, limit=20
STUDENT_COMPLETION_WINDOW_MS=300000
STUDENT_COMPLETION_LIMIT=20

# Student quiz-answer limiter. Code defaults: windowMs=300000, limit=10
STUDENT_QUIZ_ANSWER_WINDOW_MS=300000
STUDENT_QUIZ_ANSWER_LIMIT=10

# ---------------------------------------------------------------------------
# Auth token tuning
# ---------------------------------------------------------------------------

# Code default: 15m
ACCESS_TOKEN_TTL=15m
# Code default: 30. Raised to 365 here so an installed PWA that's opened at
# least once within the window stays signed in indefinitely (the refresh
# token rotates and its expiry slides forward on every /auth/refresh call —
# see server/middleware/auth.js createRefreshToken/consumeRefreshToken).
REFRESH_TOKEN_DAYS=365

# ---------------------------------------------------------------------------
# Online fee payments - Razorpay SANDBOX (optional; server/services/payments/)
# ---------------------------------------------------------------------------
# Leave all three unset to run without online payments: fee records, balances,
# and the admin fee tools keep working, and students see a "pay at the fee
# desk" message instead of a Pay button. Secrets belong ONLY in the
# environment - they are never returned by any API or stored in the database.
#
# All three are required to enable payments (Razorpay Dashboard, Test Mode).
# Key id must look like rzp_test_XXXX; live keys (rzp_live_) are rejected
# unless RAZORPAY_ALLOW_LIVE=true.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the webhook in the Razorpay Dashboard. Webhook URL:
#   https://<your-host>/api/payments/webhook
# Subscribe to: payment.captured, payment.failed, order.paid
# Enable automatic capture so authorised payments are captured.
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_ALLOW_LIVE=false
# Webhook rate limit per IP. Code defaults: windowMs=60000, limit=300
PAYMENT_WEBHOOK_WINDOW_MS=60000
PAYMENT_WEBHOOK_LIMIT=300
