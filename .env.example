HOST=127.0.0.1
PORT=5055
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long
LOW_ATTENDANCE_THRESHOLD=75
CLIENT_ORIGIN=http://127.0.0.1:5175
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=use-a-unique-admin-password
SEED_STUDENT_PASSWORD=use-a-unique-student-password

# Teacher accounts do not use a shared password. Each teacher's demo login
# is <CODE>@Uem2026 (e.g. lrg@example.edu / LRG@Uem2026) unless overridden
# below.
#
# Optional: give an individual faculty member (by their teacher code, see
# server/db/seedData.js -> teacherProfiles) their own real login instead of
# the "<CODE>@Uem2026" demo password above. Example for the SBK code:
# FACULTY_SBK_EMAIL=faculty.member@example.edu
# FACULTY_SBK_PASSWORD=use-a-unique-faculty-password

# Geofenced attendance: the app itself works from anywhere (any city,
# any network), but a student can only mark themselves present when their
# device's GPS location is within COLLEGE_RADIUS_METERS of this point.
# Look up your campus's coordinates (e.g. via Google Maps: right-click the
# spot -> click the lat/lng) and set them here. Leave unset to disable
# geofenced check-in entirely (the "Mark my attendance" card will not show).
#
# Set below to University of Engineering & Management (UEM), Jaipur -
# Gurukul, Sikar Road, Jaipur. Campus is ~32 acres; 300m covers the whole
# built-up area plus normal GPS drift without reaching the public highway
# out front. Narrow this down (e.g. to 120-150m) if you want the check
# tighter to a single building/block instead of the whole campus.
COLLEGE_LATITUDE=27.2124649
COLLEGE_LONGITUDE=75.7002425
COLLEGE_RADIUS_METERS=300

# Teacher accounts: each teacher code (e.g. LRG, SBK - these are visible to
# any student on the public class schedule) gets a demo login of
# <CODE>@Uem2026 unless you set FACULTY_<CODE>_EMAIL / FACULTY_<CODE>_PASSWORD
# for that code. In production, the server refuses to start if any teacher
# is still on the guessable demo password, since anyone who's seen a
# timetable can compute it. Either set real passwords for every teacher code
# you use, or explicitly accept the demo passwords (e.g. for a staging
# deployment) with:
# ALLOW_DEMO_TEACHER_PASSWORDS=true
