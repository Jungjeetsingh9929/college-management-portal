# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=5055
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=
DB_FILE_PATH=

# Browser-facing origin. Use the exact deployed origin in production.
CLIENT_ORIGIN=http://localhost:5175
FRONTEND_URL=http://localhost:5175
BACKEND_URL=http://localhost:5055
TRUST_PROXY=0

# Bootstrap credentials. Use unique operator-managed values outside local development.
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_STUDENT_PASSWORD=replace-with-a-strong-password
SEED_FACULTY_PASSWORD=replace-with-a-strong-password
ALLOW_DEMO_LOGIN=false
DEMO_LOGIN_EMAIL=example@gmail.com
DEMO_LOGIN_PASSWORD=replace-with-a-strong-password

# Token and audit settings
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
AUDIT_LOG_MAX_EVENTS=10000
LOW_ATTENDANCE_THRESHOLD=75

# Attendance geofence. Leave unset to disable quiz/check-in attendance.
COLLEGE_LATITUDE=
COLLEGE_LONGITUDE=
COLLEGE_RADIUS_METERS=200

# Upload and payment settings
UPLOAD_DIR=./storage
SUBMISSION_MAX_BYTES=5242880
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE=false
RAZORPAY_API_BASE=https://api.razorpay.com
