{
  "name": "college-management-portal",
  "version": "1.0.0",
  "description": "College management portal with role-based dashboards for attendance, timetables, assignments, marks and fees.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --host 0.0.0.0 --port 5175",
    "server": "NODE_ENV=development node server/index.js",
    "seed": "node server/scripts/seed.js",
    "test": "node tests/run-all.js",
    "build": "vite build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.13.3",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
